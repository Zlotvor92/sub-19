+/* A11 — dani plana kakvi se upisuju posle adaptacije (jedino mesto): nedelja koja je cela ≤ asOf ostaje iz
+   prethodnog plana; u ostalim nedeljama zaštićeni dani (≤ asOf, urađeni, zaključani) iz prethodnog plana i
+   sastavljeni dani na ostalim datumima. Čitaju ga spajanje (adapt.ts) i konstruktor (generate.ts: najduži dugi
+   D7 iz upisanih dana, 10k-v2.5.1). */
+
+import { mustDay } from './dates.ts';
+import type { PlanDay, PlanWeek } from './types.ts';
+
+/** Prethodni plan i zaštita dana (A11) za koje konstruktor računa upisane dane. */
+export interface Written {
+  weeks: readonly PlanWeek[];
+  /** Zaštićen dan: ≤ asOf, urađen ili zaključan. */
+  keep: (d: PlanDay) => boolean;
+  /** asOf (broj dana). */
+  asOf: number;
+}
+
+/** Dani nedelje kakvi se upisuju: `prev` = ista nedelja prethodnog plana, `built` = sastavljeni dani. */
+export function writtenDays(
+  prev: PlanWeek,
+  built: readonly PlanDay[],
+  w: Written
+): readonly PlanDay[] {
+  if (mustDay(prev.endDate) <= w.asOf) return prev.days;
+  return [
+    ...prev.days.filter(w.keep),
+    ...built.filter((d) => !prev.days.some((x) => x.date === d.date && w.keep(x)))
+  ].sort((x, y) => x.date.localeCompare(y.date));
+}
