+++ b/web/src/domain/generators/tenK/v2/earlyGrid.harness.node.test.ts
@@ -0,0 +1,148 @@
+/* Mreža E 10K v2 (segment 06d, 10k-v2.5.1, N7): rana adaptacija i adaptacija pred nedeljom testa — zajednički kod za
+   earlyGrid.node.test.ts i earlyGrid.<k>.full.node.test.ts.
+
+   Planovi: svaki 12. ulaz mreže 01 (gridInputs), svaki 7. mreže po osećaju (feelGridInputs 3–6), svaki 3. mreže
+   početnika (beginnerGridInputs 3–4). asOf: sreda i kraj nedelje 1; u planu sa testom i sreda i kraj nedelje pre
+   nedelje testa (kad je to nedelja ≥ 2). Scenariji pretrage N7: pauza 10 i 20 dana (breaks do asOf), bol 5 i 8
+   (painFacts), pauza 10 + bol 5, manjak (odrađen samo dan asOf − 6 po planu, pokrivenost asOf − 6 … asOf).
+   Po toku: prihvaćen (0 odbijanja), adaptInvariants prazno (Uslov 8: nijedan prazan trening, dugi ≥ lagan, nedelja ≥
+   minimum), regresija: tok prihvaćen na 51a924f (10k-v2.5.0) bajt-isti (heš bez oznake verzije,
+   segment06d.early-hashes-51a924f.json; ranije odbijen tok tamo je 0).
+
+   - BRZ nivo: deterministički uzorak (svaki K_FAST. tok unutar porodice × scenario) + imenovani primeri K1/K2.
+   - PUN nivo: delovi po indeksu plana (`part`, EARLY_PARTS); glavni fajl = deo 1. */
+
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { beforeAll, describe, expect, it } from 'vitest';
+import { FULL, part, sample } from '@/test/level';
+import { adaptTenKV2 } from './adapt.ts';
+import { adaptInvariants } from './adaptInvariants.ts';
+import { generateTenKV2 } from './generate.ts';
+import { GRID_TIMEOUT, missingParts } from './level.harness.node.test.ts';
+import {
+  EARLY_SCENARIOS,
+  type EarlyScenario,
+  earlyAsOfs,
+  earlyFacts,
+  earlyGridBases,
+  planHash06c
+} from './testInputs.ts';
+import type { TenKV2Facts, TenKV2Plan } from './types.ts';
+
+export const EARLY_PARTS = 4;
+const K_FAST = 45;
+const HERE = fileURLToPath(new URL('./', import.meta.url));
+export const EARLY_HASHES = `${HERE}segment06d.early-hashes-51a924f.json`;
+
+export interface EarlyPlan {
+  id: string;
+  family: 'R' | 'F' | 'B';
+  input: Record<string, unknown>;
+}
+export const earlyPlans = (): EarlyPlan[] => earlyGridBases();
+
+const plans = new Map<string, TenKV2Plan>();
+export function earlyPlan(p: EarlyPlan): TenKV2Plan {
+  let x = plans.get(p.id);
+  if (!x) {
+    const r = generateTenKV2(p.input);
+    if (!r.ok) throw new Error(`${p.id}: ${JSON.stringify(r.reasons)}`);
+    plans.set(p.id, (x = r.plan));
+  }
+  return x;
+}
+
+export interface EarlyFlow {
+  /** Redni broj u celom skupu (redosled heševa u EARLY_HASHES). */
+  n: number;
+  key: string;
+  plan: EarlyPlan;
+  asOf: string;
+  s: EarlyScenario;
+}
+
+let allFlows: EarlyFlow[] | null = null;
+/** Svi tokovi mreže E (redosled: plan, asOf, scenario). */
+export function earlyAll(): EarlyFlow[] {
+  if (allFlows) return allFlows;
+  const out: EarlyFlow[] = [];
+  for (const plan of earlyPlans())
+    for (const a of earlyAsOfs(earlyPlan(plan)))
+      for (const s of EARLY_SCENARIOS)
+        out.push({ n: out.length, key: `${plan.id}/${a.tag}/${s}`, plan, asOf: a.asOf, s });
+  return (allFlows = out);
+}
+
+/** Imenovani primeri N7 u mreži (uvek u uzorku brzog nivoa): K1 pauza 20 kraj ned 1, K2 bol 5 sreda ned 1. Primer K1
+    bol 5 u četvrtak ned 1 nije asOf mreže — poseban test u earlyGrid.node.test.ts. */
+export const NAMED_EARLY = [
+  'f-d5-12w-30km-e270-C-sat/w1end/pause20',
+  'f-d5-8w-35km-e270-A-sat/w1wed/pain5',
+  'f-d5-8w-35km-e270-A-sat/w1wed/pain8'
+];
+
+/** Tokovi brzog nivoa (uzorak) ili dela punog (planovi `part`). */
+export function earlyCases(partIndex: number): EarlyFlow[] {
+  const flows = earlyAll();
+  if (FULL) {
+    const ids = new Set(part(earlyPlans(), partIndex, EARLY_PARTS).map((p) => p.id));
+    return flows.filter((f) => ids.has(f.plan.id));
+  }
+  return sample(
+    flows,
+    K_FAST,
+    (f) => `${f.plan.family}/${f.s}`,
+    (f) => NAMED_EARLY.includes(f.key)
+  );
+}
+
+export function runEarly(f: EarlyFlow): { ok: boolean; bad: string[]; hash: number } {
+  const p0 = earlyPlan(f.plan);
+  const facts = earlyFacts(p0, f.s, f.asOf);
+  const r = adaptTenKV2(p0, facts, f.asOf);
+  if (!r.ok) return { ok: false, bad: [`${f.key}: ${JSON.stringify(r).slice(0, 400)}`], hash: 0 };
+  const bad = adaptInvariants(p0, r.plan, f.asOf, facts as unknown as TenKV2Facts).map(
+    (v) => `${f.key}: ${v}`
+  );
+  return { ok: true, bad, hash: planHash06c(r) };
+}
+
+/** Heševi prihvaćenih tokova na 51a924f (0 = odbijen) po rednom broju toka. */
+export const earlyHashes = (): number[] =>
+  (JSON.parse(readFileSync(EARLY_HASHES, 'utf8')) as { hashes: number[] }).hashes;
+
+/** Describe mreže E (brz: uzorak; pun: deo `partIndex`). */
+export function describeEarlyGrid(title: string, partIndex: number): void {
+  describe(title, () => {
+    let flows: EarlyFlow[] = [];
+    let res: ReturnType<typeof runEarly>[] = [];
+    beforeAll(() => {
+      flows = earlyCases(partIndex);
+      res = flows.map(runEarly);
+    }, GRID_TIMEOUT);
+
+    it('ceo skup: planovi i tokovi; pun nivo — svi delovi postoje', () => {
+      const all = earlyAll();
+      expect(new Set(all.map((f) => f.plan.id)).size).toBe(3084);
+      expect(all.length).toBe(EARLY_TOTAL);
+      expect(earlyHashes().length).toBe(all.length);
+      if (FULL) expect(missingParts(HERE, 'earlyGrid', EARLY_PARTS)).toEqual([]);
+      else expect(flows.length).toBeGreaterThan(1000);
+    });
+
+    it('0 odbijanja i adaptInvariants prazno (Uslov 8)', () => {
+      expect(res.flatMap((r) => r.bad)).toEqual([]);
+      expect(res.filter((r) => !r.ok).length).toBe(0);
+    });
+
+    it('regresija: tok prihvaćen na 51a924f bajt-isti (heš bez oznake verzije)', () => {
+      const h = earlyHashes();
+      const changed = flows.filter((f, i) => h[f.n] !== 0 && h[f.n] !== res[i]!.hash);
+      expect(changed.map((f) => f.key)).toEqual([]);
+    });
+  });
+}
+
+/** Broj tokova celog skupa. */
+export const EARLY_TOTAL = 0;
