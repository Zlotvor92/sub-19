+export function freeKind(d: Pick<PlanDay, 'role'>): FreeKind {
+  return d.role === 'long'
+    ? (globalThis as unknown as { P37_KEEP_LONG?: boolean }).P37_KEEP_LONG
+      ? 'test'
+      : 'long'
+    : d.role === 'test'
+      ? 'test'
+      : d.role === 'q1' || d.role === 'q2'
+        ? 'quality'
+        : 'easy';
+}
+
+/** Pouka 37: minimum nedelje sa zaštićenim danima `kept` i preostalim `free` [0,01 km] (lengths.mixedFloor100). */
+export function mixedMin100(kept: readonly PlanDay[], free: readonly PlanDay[]): number {
+  return (
+    kept.reduce((a, d) => a + (d.countsToWeek ? km100(d.workout.km) : 0), 0) +
+    mixedFloor100(free.map((d) => ({ kind: freeKind(d), km100: km100(d.workout.km) })))
+  );
+}
+
+/** Pouka 37: napomena mešovite nedelje čiji su preostali dani sastavljeni na ostatak (validator je čita). */
+export const MIXED_NOTE = 'mešovita nedelja (pouka 37)';
+
+/**
+ * Pouka 37 — JEDINO mesto odluke o preostalim danima mešovite nedelje (deo dana zaštićen: ≤ asOf, urađen,
+ * zaključan; `kept` = zaštićeni dani iz prethodnog plana). Cilj `target10` važi za celu nedelju: preostali dani
+ * sastavljene nedelje `built` (dani na zaštićenim datumima se ne upisuju) sastavljaju se na ostatak = cilj −
+ * zaštićeni, SAMO NANIŽE — kad zaštićeni dani nisu veći od sastavljenih za te datume ili sastavljeni preostali
+ * dani već staju u ostatak, nedelja ostaje kakva jeste (null).
+ * Struktura kao pouka 33: kvalitet ostaje, lagani se skraćuju do 4 km, pa dugi (≥ lagan, ≥ 4 km); kvalitet
+ * otpada u lagan dan (prvo Q2, pa Q1; test ostaje) tek kad ni tako ne staje, ili kad bi skraćen dugi bio kraći od
+ * dana kvaliteta (pouka 35; taper izuzet). Kad ni minimum preostalih dana (mixedMin100) ne staje → najmanja
+ * struktura, planirano > cilj (upozorenje MIXED_WEEK_OVER validatora, pouka 14), ne odbijanje. Trkačka nedelja
+ * ima svoje pravilo (pouka 5/30). Jedna petlja po opcijama strukture, ne uzastopno skraćivanje (Uslov 1).
+ */
+export function remainderWeek(
+  ctx: WeekContext,
+  frame: WeekFrame,
+  built: BuiltWeek,
+  kept: readonly PlanDay[],
+  target10: number
+): BuiltWeek | null {
+  if (frame.phase === 'race' || kept.length === 0) return null;
+  const p = ctx.paces;
+  const keptDates = new Set(kept.map((d) => d.date));
+  const free = built.days.filter((d) => !keptDates.has(d.date));
+  const sum100 = (ds: readonly PlanDay[]): number =>
+    ds.reduce((a, d) => a + (d.countsToWeek ? km100(d.workout.km) : 0), 0);
+  const kept100 = sum100(kept);
+  const rest100 = target10 * 10 - kept100;
+  // Samo naniže: menja se samo nedelja u kojoj zaštićeni dani prelaze ono što je sastavljeno za te datume.
+  if (
+    free.length === 0 ||
+    kept100 <= sum100(built.days.filter((d) => keptDates.has(d.date))) ||
+    kept100 + sum100(free) <= target10 * 10
+  )
+    return null;
+  const long = (globalThis as unknown as { P37_KEEP_LONG?: boolean }).P37_KEEP_LONG ? null : (free.find((d) => d.role === 'long') ?? null);
+  const keptLong = kept.find((d) => d.role === 'long');
+  const droppable = ['q2', 'q1']
+    .map((r) => free.find((d) => d.role === r))
+    .filter((d): d is PlanDay => !!d);
+  const quality = (d: PlanDay): boolean => d.role === 'q1' || d.role === 'q2';
+  const compose = (
+    dropN: number,
+    withKept: boolean
+  ): { days: PlanDay[]; long10: number | null } | null => {
+    const dropped = new Set(droppable.slice(0, dropN).map((d) => d.date));
+    const fixed = free.filter(
+      (d) =>
+        (quality(d) && !dropped.has(d.date)) ||
+        d.role === 'test' ||
+        (d.role === 'long' && !long)
+    );
+    const easy = free.filter((d) => d.role === 'easy' || dropped.has(d.date));
+    const len = remainderLengths(
+      rest100 - sum100(fixed),
+      long ? km10(long.workout.km) : null,
+      easy.map((d) => km10(d.workout.km))
+    );
+    if (!len) return null;
+    // Pouka 35: skraćen dugi ostaje najduži trening nedelje (taper izuzet, H7); zaštićen dan kvaliteta se
+    // poredi samo dok neka opcija to dozvoljava (zaštićen dan je činjenica).
+    if (long && len.long10 < km10(long.workout.km) && frame.phase !== 'taper') {
+      const longSec = longWorkout(len.long10 / 10, p).sec;
+      if ([...(withKept ? kept : []), ...fixed].some((d) => quality(d) && d.workout.sec > longSec))
+        return null;
+    }
+    return {
+      days: [
+        ...fixed,
+        ...(long
+          ? [
+              len.long10 === km10(long.workout.km)
+                ? long
+                : day(long.date, 'long', longWorkout(len.long10 / 10, p))
+            ]
+          : []),
+        ...easy.map((d, i) =>
+          d.role === 'easy' && km10(d.workout.km) === len.easy10[i]
+            ? d
+            : day(d.date, 'easy', easyWorkout(len.easy10[i]! / 10, p))
+        )
+      ],
+      long10: long ? len.long10 : null
+    };
+  };
+  let dropN = 0;
+  let c: ReturnType<typeof compose> = null;
+  for (const withKept of [true, false])
+    for (dropN = 0; dropN <= droppable.length && !c; dropN++) c = compose(dropN, withKept);
+  dropN--;
+  if (!c) {
+    // Najmanja struktura (samo naniže): kvalitet otpada, lagani 4 km, dugi na donjoj granici.
+    dropN = droppable.length;
+    const dropped = new Set(droppable.map((d) => d.date));
+    c = {
+      days: free.map((d) =>
+        d.role === 'test'
+          ? d
+          : d.role === 'long' && long
+            ? day(d.date, 'long', longWorkout(Math.min(km10(d.workout.km), EASY_MIN10) / 10, p))
+            : d.role === 'easy' || dropped.has(d.date)
+              ? day(d.date, 'easy', easyWorkout(Math.min(km10(d.workout.km), EASY_MIN10) / 10, p))
+              : d
+      ),
+      long10: long ? Math.min(km10(long.workout.km), EASY_MIN10) : null
+    };
+  }
+  const droppedRoles = droppable.slice(0, dropN).map((d) => d.role.toUpperCase());
+  const days = [...built.days.filter((d) => keptDates.has(d.date)), ...c.days];
+  const freeKm = sum100(c.days) / 100;
+  const over = kept100 + sum100(c.days) > target10 * 10;
+  const note = over
+    ? `Adaptacija: ${MIXED_NOTE} — zaštićeni dani ${fmtKm(kept100 / 100)} km; ni najmanji preostali dani (${fmtKm(freeKm)} km${droppedRoles.length > 0 ? `, ${droppedRoles.join(' i ')} lagan` : ''}) ne staju u ostatak ${fmtKm(Math.max(0, rest100) / 100)} km do cilja ${fmtKm(target10 / 10)} km — planirano iznad cilja.`
+    : `Adaptacija: ${MIXED_NOTE} — zaštićeni dani ${fmtKm(kept100 / 100)} km; preostali dani ${fmtKm(freeKm)} km na ostatak ${fmtKm(rest100 / 100)} km do cilja ${fmtKm(target10 / 10)} km${droppedRoles.length > 0 ? `; ${droppedRoles.join(' i ')} lagan (ne staje u ostatak)` : ''}.`;
+  const picks = built.picks
+    ? {
+        q1: droppedRoles.includes('Q1') ? null : built.picks.q1,
+        q2: droppedRoles.includes('Q2') ? null : built.picks.q2
+      }
+    : null;
+  return finish(days, keptLong ? km10(keptLong.workout.km) : c.long10, picks, [
+    ...built.notes,
+    note
+  ]);
+}
+
