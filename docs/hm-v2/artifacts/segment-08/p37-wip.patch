+  const left10 = Math.floor((rest100 - (longCap10 === null ? 0 : long10 * 10)) / 10);
+  if (n === 0) return left10 >= 0 ? { long10, easy10: [] } : null;
+  const easy10 = splitEasy(left10, n).map((e, i) => Math.min(e, caps10[i]!));
