+export function longBlockWorkout(km: number, blockKm: number, p: Paces, feel = false): Workout {
+  const eKm = Math.round((km - blockKm) * 10) / 10;
+  const w = assemble(
+    'long',
+    null,
+    `Dugi ${fmtKm(km)} km: ${fmtKm(eKm)} km lagano + ${fmtKm(blockKm)} km u maratonskom tempu`,
