+    [
+      distEasy('long', eKm, p),
+      seg('continuous', 'MP', blockKm, Math.round(blockKm * p.MP), p.MP, 'exact', 'estimated')
+    ],
+    null
+  );
+  return feel ? { ...w, rpe: rpeOf('MP') } : w;
