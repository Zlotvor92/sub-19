# Testovi i CI ne idu u deploy — nisu deo aplikacije.
/test/
/.github/
# SQL se pušta rukom u Supabase SQL Editoru. Nema tajni u njemu, ali nema ni
# razloga da stoji na javnoj adresi (/supabase/rate-limit.sql).
/supabase/
# Alat koji se pokreće jednom, rukom (pravljenje VAPID ključeva).
/scripts/
# Dokumentacija rewrite-a (audit, arhitektura, bezbednosni nalazi) ne treba da
# stoji na javnoj adresi (/docs/*.md, /ARCHITECTURE.md) — isti razlog kao supabase/.
/docs/
/ARCHITECTURE.md
/REWRITE_REPORT.md
